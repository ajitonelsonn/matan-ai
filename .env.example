# Server-only AWS credentials for Amazon Bedrock (never NEXT_PUBLIC_*)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Amazon Bedrock Configuration
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Optional: monthly Bedrock token budget guard (default 5,000,000 ≈ $4 of Nova Pro input).
# Video escalation is disabled at 80% of the budget; analyses stop at 100%.
MATAN_AI_MONTHLY_TOKEN_BUDGET=5000000

# --- Amazon Cognito (public, browser-safe identifiers; NOT secrets) ---
# Provision with `pnpm cognito:provision` (needs cognito-idp permissions) or copy from the Cognito console.
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=
# Managed-login domain without scheme, e.g. matan-ai-1234.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
# Set to true once the Google identity provider is configured on the pool.
NEXT_PUBLIC_COGNITO_GOOGLE_ENABLED=false

# Google OAuth (only used by scripts/cognito-provision.mjs to configure the Cognito IdP; never shipped to the browser)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- DynamoDB (server-only) ---
DYNAMODB_TABLE_NAME=MatanAI

# --- S3 media bucket (server-only; create with `pnpm s3:provision`) ---
S3_MEDIA_BUCKET=

# --- Amazon SES transactional notifications (server-only) ---
# Verified sender identity (a verified domain is required for production access; any address on it works).
# In SES Sandbox, recipients must be verified identities too.
SES_FROM_EMAIL=alerts@example.com
SES_CONFIGURATION_SET=matan-ai
# Used for links in emails (never derived from request headers)
APP_BASE_URL=http://localhost:3000
